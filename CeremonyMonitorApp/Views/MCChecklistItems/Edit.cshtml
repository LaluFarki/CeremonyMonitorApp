@model CeremonyMonitorApp.Models.MCChecklistItem

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>MCChecklistItem</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="CeremonyId" class="control-label"></label>
                <select asp-for="CeremonyId" class="form-control" asp-items="ViewBag.CeremonyId" >
                    <option value="0"> ---- Choose Ceremony ------</option>
                </select>
                <span asp-validation-for="CeremonyId" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="OrderIndex" class="control-label"></label>
                <input asp-for="OrderIndex" class="form-control" />
                <span asp-validation-for="OrderIndex" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ScripText" class="control-label"></label>
                <input asp-for="ScripText" class="form-control" />
                <span asp-validation-for="ScripText" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IsCompleted" class="control-label"></label>
                <input asp-for="IsCompleted" class="form-check-input" />
                <span asp-validation-for="IsCompleted" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
