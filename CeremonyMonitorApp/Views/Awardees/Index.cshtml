@model List<Awardee>
@{
    ViewData["Title"] = "Nominate Awardees"; 

}

<div class="p-0">
    <div class="flex justify-between items-center">
        <div> 
            <h1 class="text-2xl font-bold text-navy">
                Awardee Nominate
            </h1>
            <p class="text-sm text-gray-500 mt-1">
                Daftar Nominasi yg sudah anda Ajukan
            </p>
        </div>
        <a href="/Awardees/Create" class="bg-[#0056A8] text-white font-semibold px-4 py-2 rounded-lg">
            + Nominasi Baru
        </a>
    </div>

    <div class="mt-6 bg-white border rounded-lg overflow-hidden">
        <table class="w-full text-sm ">
            <thead class="bg-gray-50 text-center text-gray-500">
                <tr>
                    <th class="px-4 py-3">Employee</th>
                    <th class="px-4 py-3">Ceremony</th>
                    <th class="px-4 py-3">Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var a in Model)
                {
                    <tr class="border-t">
                        <td class="px-4 py-3">
                            <div class="font-semibold">
                                @a.Employee?.FullName
                            </div>
                            <div class="font-semibold">
                                @a.Title
                            </div>
                        </td>
                        <td class="px-4 py-3">
                            @a.Ceremony?.ScheduledDate.ToString("dd MMMM yyyy")
                        </td>
                        <td class="px-4 py-3">
                            @{
                                var (bg, text, label) = a.Stage switch
                                {
                                    ApprovalStage.Submitted => ("bg-gray-100", "text-gray-800", "Waiting Review"),
                                    ApprovalStage.HradminReview => ("bg-amber-50", "text-amber-600", "HR Admin Review"),
                                    ApprovalStage.HrManagerFinal => ("bg-blue-50", "text-blue-600", "HR Manager Review"),
                                    ApprovalStage.Approved => ("bg-green-50", "text-green-600", "Approved"),
                                    ApprovalStage.Rejected => ("bg-red-50", "text-red-600", "Rejected"),
                                    _ => ("bg-gray-100", "text-gray-600", "Unknown")
                                               
                                };
                            }
                            <span class="@bg @text px-3 py-1 rounded-full text-xs font-semibold">@label</span>
                        </td>
                    </tr>      
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3" class="px-4 py-3 text-center text-gray-500">
                            No nominations found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>