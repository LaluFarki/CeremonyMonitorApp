@model List<Awardee>
@{
    ViewData["Title"] = "Nominate Awardees"; 
}

<!-- Header Halaman -->
<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <div class="flex items-center gap-2 text-xs font-semibold text-gray-400 mb-1">
            <a href="/Home/Index" class="hover:text-[#0050A0]">Dashboard</a>
            <span>/</span>
            <span class="text-gray-600 font-bold">Nominate Awardees</span>
        </div>
        <h1 class="text-3xl font-extrabold text-[#17233F] tracking-tight">Awardee Nominations</h1>
        <p class="text-sm text-gray-500 mt-1">Submit and monitor outstanding employee nominations for your department.</p>
    </div>
    
    <!-- Action Button + Nominate New Employee -->
    <a href="/Awardees/Create" class="bg-[#0050A0] hover:bg-[#003d7a] text-white font-bold py-2.5 px-5 rounded-xl text-xs flex items-center gap-2 shadow-sm transition duration-150 shrink-0">
        <i class="bi bi-plus-lg text-xs"></i> Nominate Employee
    </a>
</div>

<!-- Table Container Card -->
<div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden mb-8">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50/40 border-b border-slate-100 text-[10px] font-black text-[#17233F] uppercase tracking-wider">
                    <th class="py-5 px-8">Employee & Award Title</th>
                    <th class="py-5 px-8">Ceremony Date</th>
                    <th class="py-5 px-8">Review Stage / Status</th>
                    <th class="py-5 px-8">Notes</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50 text-xs font-semibold text-gray-700">
                @foreach (var a in Model)
                {
                    <tr class="hover:bg-slate-50/50 transition duration-150">
                        <!-- Employee Info -->
                        <td class="py-5 px-8">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-blue-50 text-[#0050A0] flex items-center justify-center font-black">
                                    @(a.Employee?.FullName != null ? string.Join("", a.Employee.FullName.Split(' ').Select(n => n[0])).ToUpper().Substring(0, Math.Min(2, a.Employee.FullName.Split(' ').Length)) : "AW")
                                </div>
                                <div>
                                    <p class="font-extrabold text-gray-800 tracking-tight">@a.Employee?.FullName</p>
                                    <p class="text-[10px] text-gray-400 font-bold mt-0.5">@a.Title</p>
                                </div>
                            </div>
                        </td>
                        
                        <!-- Ceremony Date -->
                        <td class="py-5 px-8 align-middle text-gray-500 font-bold">
                            @a.Ceremony?.ScheduledDate.ToString("dd MMMM yyyy")
                        </td>
                        
                        <!-- Stage Badge Status -->
                        <td class="py-5 px-8 align-middle">
                            @{
                                var (bg, text, label) = a.Stage switch
                                {
                                    ApprovalStage.Submitted => ("bg-slate-100 text-slate-700 border-slate-200", "bg-slate-500", "Submitted"),
                                    ApprovalStage.HradminReview => ("bg-amber-50 text-amber-700 border-amber-100", "bg-amber-500", "HR Admin Review"),
                                    ApprovalStage.HrManagerFinal => ("bg-blue-50 text-blue-700 border-blue-100", "bg-blue-500", "HR Manager Review"),
                                    ApprovalStage.Approved => ("bg-emerald-50 text-emerald-700 border-emerald-100", "bg-emerald-500", "Approved"),
                                    ApprovalStage.Rejected => ("bg-rose-50 text-rose-700 border-rose-100 animate-pulse", "bg-rose-500", "Rejected"),
                                    _ => ("bg-slate-100 text-slate-600 border-slate-150", "bg-slate-400", "Unknown")
                                };
                            }
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-wider border @bg">
                                <span class="w-1.5 h-1.5 rounded-full @text"></span>
                                @label
                            </span>
                        </td>
                        
                        <!-- Notes / Remarks -->
                        <td class="py-5 px-8 align-middle text-gray-500 max-w-xs truncate">
                            @if (a.Stage == ApprovalStage.Rejected)
                            {
                                <span class="text-rose-600 font-bold flex items-center gap-1">
                                    <i class="bi bi-exclamation-triangle-fill"></i> @(a.HrManagerNotes ?? a.HrAdminNotes ?? "Rejected with no details")
                                </span>
                            }
                            else
                            {
                                <span class="text-gray-400">@(a.HrManagerNotes ?? a.HrAdminNotes ?? "-")</span>
                            }
                        </td>
                    </tr>      
                }
                
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="py-12 text-center text-gray-400">
                            <i class="bi bi-award text-3xl block mb-2"></i>
                            <p class="text-xs font-semibold">No employee nominations submitted yet.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>