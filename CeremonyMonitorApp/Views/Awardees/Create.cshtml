@{
    ViewData["Title"] = "Nominate Awardee";
}

<!-- Header Halaman -->
<div class="mb-8">
    <div class="flex items-center gap-2 text-xs font-semibold text-gray-400 mb-1">
        <a href="/Home/Index" class="hover:text-[#0050A0]">Dashboard</a>
        <span>/</span>
        <a href="/Awardees" class="hover:text-[#0050A0]">Nominate List</a>
        <span>/</span>
        <span class="text-gray-600 font-bold">New Nomination</span>
    </div>
    <h1 class="text-3xl font-extrabold text-[#17233F] tracking-tight">Nominate Awardee</h1>
    <p class="text-sm text-gray-500 mt-1">Submit employee outstanding achievements for this month's ceremony recognition.</p>
</div>

<div class="max-w-2xl space-y-6">

    @if (ViewBag.NoCeremonyAvailable == true)
    {
        <!-- Alert error jika tidak ada sesi upacara aktif -->
        <div class="bg-rose-50 border border-rose-100 p-4.5 rounded-2xl flex gap-3 text-xs text-rose-800 leading-relaxed font-semibold">
            <i class="bi bi-x-circle-fill text-rose-500 text-base shrink-0"></i>
            <p>No ceremony is available for nomination at this time. Please contact HR Admin to set up a ceremony schedule first.</p>
        </div>
    }
    else
    {
        var ceremony = ViewBag.CurrentCeremony as Ceremony;

        <!-- Banner Info Upacara Aktif -->
        <div class="bg-gradient-to-r from-[#0050A0] to-[#003d7a] text-white p-5 rounded-3xl shadow-sm flex items-center justify-between gap-4">
            <div class="space-y-1">
                <span class="text-[9px] font-black text-blue-200 uppercase tracking-widest block">Active Ceremony Session</span>
                <h3 class="text-sm font-extrabold flex items-center gap-2">
                    <i class="bi bi-award-fill text-yellow-400"></i> Monthly Award Presentation
                </h3>
            </div>
            <!-- Tanggal Sesi Upacara -->
            <div class="text-right">
                <p class="text-xs font-black">@ceremony?.ScheduledDate.ToString("ddd, dd MMMM yyyy")</p>
                <p class="text-[9px] text-blue-200 font-bold mt-0.5">PMI Main Field</p>
            </div>
        </div>

        <!-- Validasi Error List (Jika Ada) -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bg-rose-50 border border-rose-150 p-4 rounded-2xl text-xs text-rose-700 font-bold space-y-2">
                <p class="flex items-center gap-1.5"><i class="bi bi-exclamation-octagon-fill text-rose-500"></i> Please correct the following errors:</p>
                <ul class="list-disc pl-5 space-y-0.5"> 
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                       <li>@error.ErrorMessage</li>   
                    }
                </ul>
            </div>
        }

        <!-- Formulir Input -->
        <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
            <form asp-controller="Awardees" asp-action="Create" method="post" class="space-y-5">
                
                <!-- 1. Pilih Nama Karyawan -->
                <div class="space-y-1.5">
                    <label class="text-[10px] font-black text-gray-400 uppercase tracking-wider block">Employee Name</label>
                    <select name="EmployeeId" class="w-full px-4 py-2.5 text-xs border border-slate-200 rounded-xl bg-white focus:outline-none focus:border-[#0050A0] font-bold text-gray-700 cursor-pointer" asp-items="ViewBag.EmployeeId">
                        <option value="">-- Choose Nominated Employee --</option>
                    </select>
                </div>

                <!-- 2. Judul Penghargaan -->
                <div class="space-y-1.5">
                    <label class="text-[10px] font-black text-gray-400 uppercase tracking-wider block">Award Title</label>
                    <input type="text" name="title" value="@ViewBag.Title" class="w-full px-4 py-2.5 text-xs border border-slate-200 rounded-xl focus:outline-none focus:border-[#0050A0] font-semibold text-gray-750" placeholder="e.g. Employee of the Month" />
                </div>

                <!-- 3. Alasan Nominasi -->
                <div class="space-y-1.5">
                    <label class="text-[10px] font-black text-gray-400 uppercase tracking-wider block">Achievement Reason / Description</label>
                    <textarea name="reason" rows="4" class="w-full px-4 py-3 text-xs border border-slate-200 rounded-2xl focus:outline-none focus:border-[#0050A0] resize-none font-medium text-gray-700 leading-relaxed shadow-inner" placeholder="Explain the outstanding contribution or milestone achieved by this employee...">@ViewBag.Reason</textarea>
                </div>

                <!-- Tombol Navigasi Footer -->
                <div class="flex items-center gap-3 pt-3 border-t border-slate-50">
                    <button type="submit" class="bg-[#0050A0] hover:bg-[#003d7a] text-white font-bold py-2.5 px-6 rounded-xl text-xs flex items-center gap-2 shadow-sm transition duration-150">
                        <i class="bi bi-send-fill text-xs"></i> Submit Nomination
                    </button>
                    <a href="/Awardees" class="bg-slate-100 hover:bg-slate-200 text-slate-650 font-bold py-2.5 px-5 rounded-xl text-xs transition duration-150 border border-slate-200/50">
                        Cancel
                    </a>
                </div>
            </form>
        </div> <!-- End Formulir Card -->
    }

</div>