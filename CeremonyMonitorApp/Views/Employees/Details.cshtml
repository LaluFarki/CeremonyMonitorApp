@model CeremonyMonitorApp.Models.Employee

@{
    ViewData["Title"] = "Detail Employee";
}

<div class="pcm-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="pcm-title">Detail Karyawan</h1>
            <p class="pcm-subtitle">Informasi lengkap karyawan @Model.FullName</p>
        </div>
        <div>
            <a asp-action="Index" class="btn-pcm-secondary">
                <i class="bi bi-arrow-left"></i> Kembali ke Daftar
            </a>
        </div>
    </div>

    <div class="pcm-card" style="max-width: 640px;">
        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 56px; height: 56px; font-size: 22px;">
                @(string.IsNullOrEmpty(Model.FullName) ? "E" : Model.FullName.Substring(0, 1).ToUpper())
            </div>
            <div>
                <h4 class="mb-0 fw-bold text-dark">@Model.FullName</h4>
                <span class="pcm-badge mt-1">@(Model.Department != null ? Model.Department.Name : "Tanpa Dept")</span>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-sm-6">
                <span class="pcm-label">External ID</span>
                <div class="fw-semibold text-dark fs-6">@(string.IsNullOrEmpty(Model.ExternalID) ? "-" : Model.ExternalID)</div>
            </div>
            <div class="col-sm-6">
                <span class="pcm-label">Jabatan / Position</span>
                <div class="fw-semibold text-dark fs-6">@(string.IsNullOrEmpty(Model.Position) ? "-" : Model.Position)</div>
            </div>
            <div class="col-sm-6">
                <span class="pcm-label">Departemen</span>
                <div class="fw-semibold text-dark fs-6">@(Model.Department != null ? Model.Department.Name : "-")</div>
            </div>
            <div class="col-sm-6">
                <span class="pcm-label">Last Synced At</span>
                <div class="fw-semibold text-dark fs-6">@(Model.LastSyncedAt.HasValue ? Model.LastSyncedAt.Value.ToString("dd MMMM yyyy HH:mm") : "-")</div>
            </div>
        </div>

        <div class="d-flex gap-3 pt-3 border-top">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn-pcm-primary">
                Edit Data
            </a>
            <a asp-action="Index" class="btn-pcm-secondary">
                Tutup
            </a>
        </div>
    </div>
</div>
