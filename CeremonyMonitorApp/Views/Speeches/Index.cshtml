@model IEnumerable<CeremonyMonitorApp.Models.Speech>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            
            <th>
                @Html.DisplayNameFor(model => model.Ceremony)
            </th>
           
            <th>
                @Html.DisplayNameFor(model => model.AttributedTo)
            </th>
           
            <th>
                @Html.DisplayNameFor(model => model.InputBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TextJapanaese)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TextIndonesia)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.CeremonyId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Ceremony)
            </td>
            <td>
                @Html.DisplayFor(model => item.AttributedToId)
            </td>
            <td>
                @Html.DisplayFor(model => item.AttributedTo)
            </td>
            <td>
                @Html.DisplayFor(model => item.InputById)
            </td>
            <td>
                @Html.DisplayFor(model => item.InputBy)
            </td>
            <td>
                @Html.DisplayFor(model => item.TextJapanaese)
            </td>
            <td>
                @Html.DisplayFor(model => item.TextIndonesia)
            </td>
            <td>
                @Html.DisplayFor(model => item.UpdatedAt)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
