                    <i class="bi bi-grid-3x3-gap"></i> 12-Month Schedule
                </button>
                <button class="text-gray-500 hover:text-gray-700 font-semibold text-xs px-4 py-2 rounded-xl flex items-center gap-1.5 transition duration-150">
                    <i class="bi bi-list-task"></i> List View
                </button>
            </div>
            <span class="text-xs font-semibold text-gray-400">Year: 2026</span>
        </div>

        <!-- 12 Months Grid (4 columns x 3 rows) -->
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
            
            <!-- Jan -->
