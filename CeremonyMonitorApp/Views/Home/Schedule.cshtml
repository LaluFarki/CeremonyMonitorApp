                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-orange-100 text-orange-850">Completed</span>
                </div>
                <div class="my-2">
                    <p class="text-xs font-bold text-gray-400">Department</p>
                    <p class="text-sm font-extrabold text-[#0050A0] mt-0.5">AC Department</p>
                    <p class="text-xs font-bold text-gray-700 mt-2"><i class="bi bi-calendar-event"></i> 17 Jan 2026</p>
                </div>
            </div>

            <!-- Feb -->
            <div class="bg-[#FFF8F2] border border-[#FFEAD5] rounded-3xl p-4 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between h-40">
