@{
    ViewData["Title"] = "Practice";
}

<!-- header halaman -->
<div class="mb-8">
    <div class="flex items-center gap-2 text-xs font-semibold text-gray-400 mb-1">
        <a href="/Home/Index" class="hover:text-[#0050A0]">Dashboard</a>
        <span>/</span>
        <span class="text-gray-600 font-bold">Practice</span>
    </div>

    <h1 class="text-3xl font-extrabold text-[#17233F] tracking-tight">Practice Mode</h1>
    <p class="text-sm text-gray-500 mt-1">Simulate ceremony without affecting actual data</p>
</div>

<!-- Layout Utama  -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

    <!-- Kiri: simulasi utama -->
    <div class="lg:col-span-4 space-y-6">

        <!-- ========================================== -->
        <!-- PANEL FORM INPUT JADWAL LATIHAN (KIRI)     -->
        <!-- ========================================== -->
        <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm space-y-5">
            <h2 class="text-base font-extrabold text-gray-800 flex items-center gap-2">
                <i class="bi bi-calendar-plus text-[#0050A0]"></i> Create Practice Session
            </h2>

            <!-- 1. Pilih Sesi Upacara Rujukan -->
            <div class="space-y-1.5">
                <label class="text-[10px] font-extrabold text-gray-400 uppercase tracking-wider block">Target Ceremony</label>
                <select id="inputCeremony" class="w-full px-4 py-2.5 text-xs border border-slate-200 rounded-xl bg-white focus:outline-none focus:border-[#0050A0] font-bold text-gray-700 cursor-pointer">
                    <option value="August 2026 - AC Department">August 2026 - AC Department</option>
                    <option value="September 2026 - Production 1">September 2026 - Production 1</option>
                    <option value="October 2026 - Engineering">October 2026 - Engineering</option>
                </select>
            </div>
            <!-- 2. Input Tanggal Latihan -->
            <div class="space-y-1.5">
                <label class="text-[10px] font-extrabold text-gray-400 uppercase tracking-wider block">Practice Date</label>
                <input type="date" id="inputDate" class="w-full px-4 py-2.5 text-xs border border-slate-200 rounded-xl focus:outline-none focus:border-[#0050A0] font-bold text-gray-700 cursor-pointer"/>
            </div>
            <!-- 3. Input Waktu Latihan -->
            <div class="space-y-1.5">
                <label class="text-[10px] font-extrabold text-gray-400 uppercase tracking-wider block">Time Range</label>
                <input type="text" id="inputTime" class="w-full px-4 py-2.5 text-xs border border-slate-200 rounded-xl focus:outline-none focus:border-[#0050A0] font-semibold text-gray-650" placeholder="e.g. 08:00 - 09:30" value="08:00 - 09:30"/>
            </div>
            <!-- 4. Input Lokasi (Default: PMI Field) -->
            <div class="space-y-1.5">
                <label class="text-[10px] font-extrabold text-gray-400 uppercase tracking-wider block">Location</label>
                <input type="text" id="inputLocation" class="w-full px-4 py-2.5 text-xs border border-slate-200 rounded-xl focus:outline-none focus:border-[#0050A0] font-bold text-gray-700" value="PMI Field"/>
            </div>
            <!-- Tombol Aksi Simpan -->
            <div class="pt-2">
                <button onclick="addPracticeSession()" class="w-full bg-[#0050A0] hover:bg-[#003d7a] text-white font-bold py-2.5 px-4 rounded-xl text-xs flex items-center justify-center gap-2 transition duration-150 shadow-sm">
                    <i class="bi bi-floppy"></i> Save Practice Schedule
                </button>
            </div>
        </div> <!-- End Panel Form -->

    </div>


    <div class="lg:col-span-8 space-y-4">

        <div class="bg-white rounded-3xl border-slate-100 shadow-sm overflow-hidden">
            <div class="p-5 border-b border-slate-100 bg-slate-50/100 flex items-center justify-between">
                <h3 class="text-sm font-extrabold text-gray-800 flex items-center justify-between">
                    <i class="bi bi-calendar3-event text-[#0050A0] px-3"></i>
                    Active Practice Schedules
                </h3>
                <span id="sessionCount" class="text-xs font-bold text-gray-400 bg-slate-100 px-2.5 py-1 rounded-full">
                    3 Sessions
                </span>
            </div>

            <div class="p-6 space-y-4" id="practiceSessionsContainer">
                <!-- Javascript akan memasukkan daftar kartu latihan secara dinamis di sini -->
            </div>
        </div>

    </div>
</div>

<!--Allert  Banner Notification (Hidden by Default)-->
<div id="toastNotification" class="fixed bottom-5 right-5 bg-slate-900 text-white text-xs font-bold
px-5 py-3.5 rounded-2xl shadow-2xl flex items-center gap-2 transform translate-y-20 opacity-0 transition-all 
duration-300 pointer-events-none z-50">
    <i></i>
    <span id="toatMessage">Practice Schedule saved successfully</span>
</div>

