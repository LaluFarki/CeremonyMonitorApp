@{
    ViewData["Title"] = "Practice";
}

<!-- header halaman -->
<div class="mb-8">
    <div class="flex items-center gap-2 text-xs font-semibold text-gray-400 mb-1">
        <a href="/Home/Index" class="hover:text-[#0050A0]">Dashboard</a>
        <span>/</span>
        <span class="text-gray-600 font-bold">Practice</span>
    </div>

    <h1 class="text-3xl font-extrabold text-[#17233F] tracking-tight">Practice Mode</h1>
    <p class="text-sm text-gray-500 mt-1">Simulate ceremony without affecting actual data</p>
</div>

<!-- Layout Utama  -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

    <!-- Kiri: simulasi utama -->
    <div class="lg:col-span-4 space-y-6">

        <!-- ========================================== -->
        <!-- PANEL FORM INPUT JADWAL LATIHAN (KIRI)     -->
        <!-- ========================================== -->
        <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm space-y-5">
            <h2 class="text-base font-extrabold text-gray-800 flex items-center gap-2">
                <i class="bi bi-calendar-plus text-[#0050A0]"></i> Create Practice Session
            </h2>

            <!-- 1. Pilih Sesi Upacara Rujukan -->
            <div class="space-y-1.5">
                <label class="text-[10px] font-extrabold text-gray-400 uppercase tracking-wider block">Target Ceremony</label>
                <select id="inputCeremony" class="w-full px-4 py-2.5 text-xs border border-slate-200 rounded-xl bg-white focus:outline-none focus:border-[#0050A0] font-bold text-gray-700 cursor-pointer">
                    <option value="August 2026 - AC Department">August 2026 - AC Department</option>
                    <option value="September 2026 - Production 1">September 2026 - Production 1</option>
                    <option value="October 2026 - Engineering">October 2026 - Engineering</option>
                </select>
            </div>
            <!-- 2. Input Tanggal Latihan -->
            <div class="space-y-1.5">
                <label class="text-[10px] font-extrabold text-gray-400 uppercase tracking-wider block">Practice Date</label>
                <input type="date" id="inputDate" class="w-full px-4 py-2.5 text-xs border border-slate-200 rounded-xl focus:outline-none focus:border-[#0050A0] font-bold text-gray-700 cursor-pointer"/>
            </div>
            <!-- 3. Input Waktu Latihan -->
            <div class="space-y-1.5">
                <label class="text-[10px] font-extrabold text-gray-400 uppercase tracking-wider block">Time Range</label>
                <input type="text" id="inputTime" class="w-full px-4 py-2.5 text-xs border border-slate-200 rounded-xl focus:outline-none focus:border-[#0050A0] font-semibold text-gray-650" placeholder="e.g. 08:00 - 09:30" value="08:00 - 09:30"/>
            </div>
            <!-- 4. Input Lokasi (Default: PMI Field) -->
            <div class="space-y-1.5">
                <label class="text-[10px] font-extrabold text-gray-400 uppercase tracking-wider block">Location</label>
                <input type="text" id="inputLocation" class="w-full px-4 py-2.5 text-xs border border-slate-200 rounded-xl focus:outline-none focus:border-[#0050A0] font-bold text-gray-700" value="PMI Field"/>
            </div>
            <!-- Tombol Aksi Simpan -->
            <div class="pt-2">
                <button onclick="addPracticeSession()" class="w-full bg-[#0050A0] hover:bg-[#003d7a] text-white font-bold py-2.5 px-4 rounded-xl text-xs flex items-center justify-center gap-2 transition duration-150 shadow-sm">
                    <i class="bi bi-floppy"></i> Save Practice Schedule
                </button>
            </div>
        </div> <!-- End Panel Form -->

    </div>


    <div class="lg:col-span-8 space-y-4">

        <div class="bg-white rounded-3xl border-slate-100 shadow-sm overflow-hidden">
            <div class="p-5 border-b border-slate-100 bg-slate-50/100 flex items-center justify-between">
                <h3 class="text-sm font-extrabold text-gray-800 flex items-center justify-between">
                    <i class="bi bi-calendar3-event text-[#0050A0] px-3"></i>
                    Active Practice Schedules
                </h3>
                <span id="sessionCount" class="text-xs font-bold text-gray-400 bg-slate-100 px-2.5 py-1 rounded-full">
                    3 Sessions
                </span>
            </div>

            <div class="p-6 space-y-4" id="practiceSessionsContainer">
                <!-- Javascript akan memasukkan daftar kartu latihan secara dinamis di sini -->
            </div>
        </div>

    </div>
</div>

<!-- Alert Banner Notification (Hidden by default) -->
<div id="toastNotification" class="fixed bottom-5 right-5 bg-slate-900 text-white text-xs font-bold px-5 py-3.5 rounded-2xl shadow-2xl flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none z-50">
    <i class="bi bi-check-circle-fill text-emerald-500 text-sm"></i>
    <span id="toastMessage">Practice schedule saved successfully!</span>
</div>

@section Scripts {
    <script>
        // 1. Database Tiruan Latihan (Mock Practice Sessions)
        let practiceSessions = [
            { id: 1, ceremony: "August 2026 - AC Department", date: "2026-08-24", time: "08:00 - 09:30", location: "PMI Field" },
            { id: 2, ceremony: "August 2026 - AC Department", date: "2026-08-25", time: "08:00 - 09:30", location: "PMI Field" },
            { id: 3, ceremony: "September 2026 - Production 1", date: "2026-09-14", time: "08:00 - 09:30", location: "PMI Field" }
        ];

        // DOM elements
        const inputCeremony = document.getElementById("inputCeremony");
        const inputDate = document.getElementById("inputDate");
        const inputTime = document.getElementById("inputTime");
        const inputLocation = document.getElementById("inputLocation");
        const container = document.getElementById("practiceSessionsContainer");
        const sessionCount = document.getElementById("sessionCount");
        const toast = document.getElementById("toastNotification");
        const toastMessage = document.getElementById("toastMessage");

        // 2. Set Tanggal Default ke Hari Ini
        function initDefaultDate() {
            const today = new Date();
            const yyyy = today.getFullYear();
            let mm = today.getMonth() + 1;
            let dd = today.getDate();
            if (dd < 10) dd = '0' + dd;
            if (mm < 10) mm = '0' + mm;
            inputDate.value = `${yyyy}-${mm}-${dd}`;
        }

        // Helper untuk memecah string tanggal "YYYY-MM-DD" menjadi Bulan & Tanggal untuk Kalender
        function getCalendarDate(dateString) {
            const dateObj = new Date(dateString);
            const months = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
            return {
                day: dateObj.getDate() || "01",
                month: months[dateObj.getMonth()] || "JAN"
            };
        }

        // 3. Render Kartu Jadwal Latihan
        function renderSessions() {
            container.innerHTML = "";
            sessionCount.innerText = `${practiceSessions.length} Session${practiceSessions.length !== 1 ? 's' : ''}`;

            if (practiceSessions.length === 0) {
                container.innerHTML = `
                                <div class="py-12 text-center text-gray-400">
                                    <i class="bi bi-calendar-x text-3xl block mb-2"></i>
                                    <p class="text-xs font-semibold">No practice sessions scheduled yet.</p>
                                </div>
                            `;
                return;
            }

            practiceSessions.forEach((session) => {
                const cal = getCalendarDate(session.date);
                const sessionDiv = document.createElement("div");
                sessionDiv.className = "flex items-center justify-between gap-4 p-4 rounded-2xl border border-slate-100 hover:border-slate-200 bg-slate-50/30 hover:bg-slate-50/70 transition duration-150";

                sessionDiv.innerHTML = `
                                <div class="flex items-center gap-4 min-w-0">
                                    <!-- Kotak Kalender Premium -->
                                    <div class="w-12 h-14 rounded-xl bg-[#EBF3FF] border border-blue-100/50 flex flex-col items-center justify-center shrink-0">
                                        <span class="text-[9px] font-black text-[#0050A0] tracking-wider leading-none">${cal.month}</span>
                                        <span class="text-lg font-black text-[#0050A0] leading-none mt-1.5">${cal.day}</span>
                                    </div>
                                    
                                    <!-- Detail Sesi Latihan -->
                                    <div class="min-w-0">
                                        <h4 class="text-xs font-black text-gray-800 truncate">${session.ceremony}</h4>
                                        <div class="flex flex-wrap gap-x-3 gap-y-1 text-[10px] text-gray-400 font-bold mt-1">
                                            <span class="flex items-center gap-1"><i class="bi bi-clock"></i> ${session.time}</span>
                                            <span class="flex items-center gap-1"><i class="bi bi-geo-alt"></i> ${session.location}</span>
                                        </div>
                                    </div>
                                </div>
            
                                <!-- Tombol Hapus Latihan -->
                                <button onclick="deletePracticeSession(${session.id})" class="text-rose-500 hover:text-rose-700 hover:bg-rose-50 w-8 h-8 rounded-xl flex items-center justify-center transition shrink-0" title="Delete Schedule">
                                    <i class="bi bi-trash-fill text-sm"></i>
                                </button>
                            `;
                container.appendChild(sessionDiv);
            });
        }

        // 4. Aksi Tambah Jadwal Latihan Baru
        function addPracticeSession() {
            const dateValue = inputDate.value;
            const timeValue = inputTime.value.trim();
            const locationValue = inputLocation.value.trim();
            const ceremonyValue = inputCeremony.value;

            if (!dateValue) {
                alert("Please select a practice date.");
                return;
            }

            if (!timeValue) {
                alert("Please input a practice time range.");
                return;
            }

            // Simpan ke array
            const newSession = {
                id: Date.now(),
                ceremony: ceremonyValue,
                date: dateValue,
                time: timeValue,
                location: locationValue || "PMI Field"
            };

            practiceSessions.push(newSession);
            renderSessions();
            showToast("Practice session added successfully!");
        }

        // 5. Aksi Hapus Jadwal Latihan
        function deletePracticeSession(id) {
            practiceSessions = practiceSessions.filter(s => s.id !== id);
            renderSessions();
            showToast("Practice session cancelled.");
        }

        // Helper Pop-up Notification Toast
        function showToast(message) {
            toastMessage.innerText = message;
            toast.classList.remove("translate-y-20", "opacity-0");
            toast.classList.add("translate-y-0", "opacity-100");

            setTimeout(() => {
                toast.classList.remove("translate-y-0", "opacity-100");
                toast.classList.add("translate-y-20", "opacity-0");
            }, 3000);
        }

        // Jalankan saat load awal
        initDefaultDate();
        renderSessions();
    </script>
}
