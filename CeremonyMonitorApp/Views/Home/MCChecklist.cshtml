@{
    ViewData["Title"] = "MC Checklist";
}

<!-- Header Halaman -->
<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <div class="flex items-center gap-2 text-xs font-semibold text-gray-400 mb-1">
            <a href="/Home/Index" class="hover:text-[#0050A0]">Dashboard</a>
            <span>/</span>
            <span class="text-gray-600">MC Checklist</span>
        </div>
        <h1 class="text-3xl font-extrabold text-[#17233F] tracking-tight">MC Checklist</h1>
        <p class="text-sm text-gray-500 mt-1">Manage MC checklist sequences. Changes sync instantly to the MC's tablet.</p>
    </div>
    
    <!-- Active Ceremony Banner -->
    <div class="flex items-center gap-3 bg-emerald-50 border border-emerald-100 px-4 py-2.5 rounded-2xl">
        <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <div class="text-xs">
            <p class="font-extrabold text-emerald-800">August 2026 Ceremony</p>
            <p class="text-[10px] text-emerald-600">AC Department • 27 Aug 2026</p>
        </div>
    </div>
</div>

<!-- Main Split Layout -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- Left Column: Editor Panel (Spans 7 cols) -->
    <div class="lg:col-span-7 space-y-6">
        
        <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm space-y-6">
            <div class="flex border-b border-slate-100 pb-3 justify-between items-center">
                <h2 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                    <i class="bi bi-list-check text-[#0050A0]"></i> Checklist Sequence Manager
                </h2>
                <span class="text-xs font-extrabold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full flex items-center gap-1">
                    <i class="bi bi-cloud-check-fill"></i> Live Synced
                </span>
            </div>

            <!-- MC Checklist Items Editor -->
            <div class="space-y-4">
                <div class="flex justify-between items-center">
                    <label class="text-xs font-extrabold text-gray-400 uppercase tracking-wider">Checklist Items</label>
                    <span class="text-xs text-gray-400 font-semibold" id="itemCount">5 Items</span>
                </div>

                <!-- Add New Item Field -->
                <div class="flex gap-2">
                    <input type="text" id="newItemInput" class="flex-grow px-4 py-2.5 text-sm border border-slate-200 rounded-xl focus:outline-none focus:border-[#0050A0]" placeholder="Add new checklist item..." />
                    <select id="newItemCategory" class="px-3 py-2.5 text-xs font-bold border border-slate-200 rounded-xl bg-gray-50 focus:outline-none text-gray-600">
                        <option value="Persiapan">Persiapan</option>
                        <option value="Acara Inti">Acara Inti</option>
                        <option value="Penutup">Penutup</option>
                    </select>
                    <button onclick="addChecklistItem()" class="bg-[#0050A0] hover:bg-[#003d7a] text-white px-4 rounded-xl text-sm font-bold flex items-center justify-center">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>

                <!-- Checklist Items List -->
                <div id="checklistEditorContainer" class="space-y-2 max-h-[420px] overflow-y-auto pr-1">
                    <!-- Javascript will populate items here -->
                </div>
            </div>
        </div>
    </div>
    
    <!-- Right Column: Tablet Simulator (Spans 5 cols) -->
    <div class="lg:col-span-5 flex flex-col items-center">
        <span class="text-xs font-extrabold text-gray-400 uppercase tracking-wider mb-3 flex items-center gap-1.5">
            <i class="bi bi-tablet"></i> Live Tablet Simulator View (MC Reader)
        </span>
        
        <!-- Tablet Frame Container -->
        <div class="w-full max-w-[380px] bg-slate-900 rounded-[48px] p-4 shadow-2xl border-4 border-slate-800 relative">
            
            <!-- Camera & Speaker slot -->
            <div class="absolute top-7 left-1/2 -translate-x-1/2 w-20 h-3 bg-slate-800 rounded-full flex items-center justify-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-700"></span>
                <span class="w-8 h-1 rounded-full bg-slate-950"></span>
            </div>

            <!-- Tablet Screen -->
            <div class="bg-slate-50 w-full h-[580px] rounded-[32px] overflow-hidden flex flex-col justify-between border border-slate-950 mt-4 relative">
                
                <!-- Status Bar -->
                <div class="bg-[#003d7a] text-white px-5 py-1.5 flex justify-between items-center text-[10px] font-bold">
                    <span class="flex items-center gap-1"><i class="bi bi-display"></i> MC Tablet View</span>
                    <span class="text-[9px] px-2 py-0.5 rounded-full bg-yellow-400/20 text-yellow-300 border border-yellow-400/30 animate-pulse flex items-center gap-1">
                        <i class="bi bi-joystick"></i> Practice Mode
                    </span>
                    <span class="flex items-center gap-1">13:00 <i class="bi bi-battery-full text-xs"></i></span>
                </div>

                <!-- Screen Header Area -->
                <div class="bg-white border-b border-slate-200 px-5 py-4">
                    <h4 class="text-xs font-black text-slate-800 uppercase tracking-wide">August Ceremony Checklist</h4>
                    <p class="text-[10px] text-slate-400 font-bold mt-0.5">AC Department • 27 Aug 2026</p>
                </div>

                <!-- Screen Content Area -->
                <div class="flex-grow p-4 overflow-y-auto bg-slate-50">
                    
                    <!-- Tablet Checklist Content -->
                    <div id="tabletChecklistContainer" class="space-y-2">
                        <!-- Javascript will render checklist here -->
                    </div>

                </div>

                <!-- Screen Footer -->
                <div class="bg-white border-t border-slate-200 p-3.5 flex justify-between items-center text-[10px] font-bold text-gray-400">
                    <span>Panasonic Intranet System</span>
                    <span class="text-emerald-500 flex items-center gap-1"><i class="bi bi-circle-fill text-[8px] animate-ping"></i> Live Syncing</span>
                </div>

            </div>
            
            <!-- Home button bezel slot -->
            <div class="w-10 h-10 rounded-full border border-slate-800 bg-slate-900 mx-auto mt-3 flex items-center justify-center">
                <div class="w-3 h-3 rounded bg-slate-850 border border-slate-800"></div>
            </div>

        </div>
    </div>
    
</div>

@section Scripts {
    <script>
        // Mock Checklist Data
        let checklistItems = [
            { id: 1, text: "Pengecekan sound system & mikrofon di lapangan", category: "Persiapan" },
            { id: 2, text: "Kesiapan barisan peserta upacara tiap departemen", category: "Persiapan" },
            { id: 3, text: "Pembina upacara memasuki lapangan & mimbar upacara", category: "Acara Inti" },
            { id: 4, text: "Menyanyikan lagu kebangsaan Indonesia Raya", category: "Acara Inti" },
            { id: 5, text: "Pembacaan doa oleh petugas penutup upacara", category: "Penutup" }
        ];

        // Tablet checked state cache (Practice mode centang)
        let checkedStates = {};

        // DOM elements
        const checklistEditorContainer = document.getElementById("checklistEditorContainer");
        const tabletChecklistContainer = document.getElementById("tabletChecklistContainer");
        const itemCountEl = document.getElementById("itemCount");

        // Category color mapper
        function getCategoryClass(category) {
            switch(category) {
                case "Persiapan": return "bg-blue-50 text-blue-700 border-blue-100";
                case "Acara Inti": return "bg-emerald-50 text-emerald-700 border-emerald-100";
                case "Penutup": return "bg-indigo-50 text-indigo-700 border-indigo-100";
                default: return "bg-slate-50 text-slate-700 border-slate-100";
            }
        }

        // Render checklist editor & tablet viewer
        function renderAll() {
            // Update counts
            itemCountEl.innerText = `${checklistItems.length} Items`;

            // Render Editor Items
            checklistEditorContainer.innerHTML = "";
            checklistItems.forEach((item, index) => {
                const itemDiv = document.createElement("div");
                itemDiv.className = "flex items-center gap-2 bg-slate-50 hover:bg-slate-100/70 border border-slate-150 p-2.5 rounded-xl transition duration-150";
                itemDiv.innerHTML = `
                    <i class="bi bi-grip-vertical text-slate-400 cursor-grab"></i>
                    <span class="text-xs font-extrabold px-2 py-0.5 rounded-full border ${getCategoryClass(item.category)}">${item.category}</span>
                    <input type="text" value="${item.text}" oninput="updateItemText(${item.id}, this.value)" class="flex-grow bg-transparent border-none text-xs font-semibold text-gray-700 focus:outline-none" />
                    <button onclick="deleteItem(${item.id})" class="text-rose-500 hover:text-rose-700 p-1.5"><i class="bi bi-trash-fill"></i></button>
                `;
                checklistEditorContainer.appendChild(itemDiv);
            });

            // Render Tablet Items
            renderTabletOnly();
        }

        function updateItemText(id, newText) {
            const item = checklistItems.find(i => i.id === id);
            if (item) {
                item.text = newText;
                renderTabletOnly();
            }
        }

        function renderTabletOnly() {
            tabletChecklistContainer.innerHTML = "";
            checklistItems.forEach((item) => {
                const isChecked = checkedStates[item.id] || false;
                const itemDiv = document.createElement("div");
                itemDiv.className = `flex items-start gap-2.5 p-3 rounded-xl border transition-all duration-200 cursor-pointer ${
                    isChecked 
                    ? "bg-emerald-500/10 border-emerald-500/20 text-emerald-800" 
                    : "bg-white border-slate-200 text-slate-700 hover:border-slate-350"
                }`;
                itemDiv.onclick = () => toggleTabletCheckbox(item.id);
                itemDiv.innerHTML = `
                    <div class="mt-0.5 w-4.5 h-4.5 rounded-md border flex items-center justify-center text-xs transition duration-150 ${
                        isChecked 
                        ? "bg-emerald-500 border-emerald-500 text-white" 
                        : "border-slate-300 bg-white"
                    }">
                        ${isChecked ? '<i class="bi bi-check-lg text-[10px] font-black"></i>' : ''}
                    </div>
                    <div class="flex-grow">
                        <span class="text-[8px] font-extrabold uppercase px-1.5 py-0.2 rounded bg-slate-100 border border-slate-200 text-slate-500 mr-1.5 ${
                            isChecked ? 'opacity-50' : ''
                        }">${item.category}</span>
                        <p class="text-[11px] font-semibold mt-0.5 inline-block leading-snug ${isChecked ? 'line-through opacity-50' : ''}">${item.text}</p>
                    </div>
                `;
                tabletChecklistContainer.appendChild(itemDiv);
            });
        }

        function addChecklistItem() {
            const textInput = document.getElementById("newItemInput");
            const catSelect = document.getElementById("newItemCategory");
            
            if (textInput.value.trim() === "") return;

            const newItem = {
                id: Date.now(),
                text: textInput.value,
                category: catSelect.value
            };

            checklistItems.push(newItem);
            textInput.value = "";
            renderAll();
        }

        function deleteItem(id) {
            checklistItems = checklistItems.filter(i => i.id !== id);
            delete checkedStates[id];
            renderAll();
        }

        function toggleTabletCheckbox(id) {
            checkedStates[id] = !checkedStates[id];
            renderTabletOnly();
        }

        // Initialize Render
        renderAll();
    </script>
}
