@{
    ViewData["Title"] = "Ceremony Dashboard";
}

<!-- Header Halaman -->
<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h1 class="text-3xl font-extrabold text-[#17233F] tracking-tight">Ceremony Dashboard</h1>
        <p class="text-sm text-gray-500 mt-1">Manage the monthly ceremony schedule and assignment status.</p>
    </div>
    <!-- Start Ceremony Button -->
    <button class="bg-gradient-to-r from-red-600 to-rose-600 text-white font-bold py-2.5 px-5 rounded-2xl shadow-md shadow-red-500/10 hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] transition-all duration-200 text-sm flex items-center gap-2">
        <i class="bi bi-play-circle-fill text-base animate-pulse"></i> Start Ceremony
    </button>
</div>

<!-- Quick Stats Section -->
<div class="mb-8">
    <h2 class="text-base font-bold text-gray-800 mb-4 flex items-center gap-2">
        <i class="bi bi-grid text-[#0050A0]"></i> Quick Stats
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Stat 1: Scheduled -->
        <div class="bg-gradient-to-br from-blue-50/60 to-blue-100/30 border border-blue-100/70 rounded-3xl p-6 shadow-sm flex flex-col justify-between h-36 hover:-translate-y-1 hover:shadow-md transition-all duration-300">
            <div class="flex items-center gap-2.5 text-xs font-extrabold uppercase tracking-wider text-[#0050A0]">
                <div class="w-8 h-8 rounded-xl bg-[#0050A0]/10 flex items-center justify-center">
                    <i class="bi bi-calendar3 text-base"></i>
                </div>
                SCHEDULED
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-4xl font-black text-gray-800">11</span>
                <span class="text-sm font-semibold text-gray-500">Ceremonies</span>
            </div>
        </div>

        <!-- Stat 2: On Progress -->
        <div class="bg-gradient-to-br from-emerald-50/60 to-emerald-100/30 border border-emerald-100/70 rounded-3xl p-6 shadow-sm flex flex-col justify-between h-36 hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative">
            <div class="flex items-center gap-2.5 text-xs font-extrabold uppercase tracking-wider text-[#107C41]">
                <div class="w-8 h-8 rounded-xl bg-[#107C41]/10 flex items-center justify-center">
                    <i class="bi bi-arrow-repeat text-base"></i>
                </div>
                ON PROGRESS
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-4xl font-black text-gray-800">1</span>
                <span class="text-sm font-semibold text-gray-500">Active Schedule</span>
            </div>
            <div class="absolute bottom-6 right-6 px-3 py-1 rounded-full bg-emerald-500/10 text-xs font-extrabold text-[#107C41]">
                Agustus 2026
            </div>
        </div>

        <!-- Stat 3: History -->
        <div class="bg-gradient-to-br from-rose-50/60 to-rose-100/30 border border-rose-100/70 rounded-3xl p-6 shadow-sm flex flex-col justify-between h-36 hover:-translate-y-1 hover:shadow-md transition-all duration-300">
            <div class="flex items-center gap-2.5 text-xs font-extrabold uppercase tracking-wider text-[#C53030]">
                <div class="w-8 h-8 rounded-xl bg-[#C53030]/10 flex items-center justify-center">
                    <i class="bi bi-clock-history text-base"></i>
                </div>
                HISTORY
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-4xl font-black text-gray-850">18</span>
                <span class="text-sm font-semibold text-gray-500">Completed</span>
            </div>
        </div>
    </div>
</div>

<!-- Quick Information Section -->
<div class="mb-6">
    <h2 class="text-base font-bold text-gray-800 mb-4 flex items-center gap-2">
        <i class="bi bi-info-circle text-[#0050A0]"></i> Quick Information
    </h2>
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
        
        <!-- KOLOM KIRI (Spans 3 cols): ON GOING & ASSIGNED ROLES -->
        <div class="lg:col-span-3 bg-white p-6 rounded-3xl border border-slate-100 shadow-sm flex flex-col justify-between">
            <div>
                <h3 class="text-lg font-bold text-gray-850 mb-4">On Going</h3>
                
                <!-- Grid 8 Box Informasi Utama Upacara (Menggunakan layout grid-cols-5) -->
                <div class="grid grid-cols-5 gap-3 mb-6">
                    <!-- Row 1 -->
                    <div class="col-span-2 bg-gradient-to-r from-[#0050A0] to-[#0065C5] text-white rounded-2xl p-4 shadow-sm shadow-[#0050A0]/10 flex flex-col justify-center">
                        <span class="text-[9px] font-bold text-blue-200 uppercase tracking-wider">Department :</span>
                        <span class="text-base font-extrabold mt-0.5">Air Conditioner</span>
                    </div>
                    <div class="col-span-1 bg-[#EBF7EE] border border-green-100 rounded-2xl p-3 flex flex-col justify-center items-center text-center shadow-sm shadow-emerald-500/5">
                        <span class="text-[9px] font-bold text-gray-400 uppercase tracking-wider">Role Filled</span>
                        <span class="text-sm font-black text-green-700 mt-1">8 / 12</span>
                    </div>
                    <div class="col-span-1 bg-[#FDF2F2] border border-red-100 rounded-2xl p-3 flex flex-col justify-center items-center text-center shadow-sm shadow-rose-500/5">
                        <span class="text-[9px] font-bold text-gray-400 uppercase tracking-wider">Awardee</span>
                        <span class="text-sm font-black text-red-600 mt-1">Empty</span>
                    </div>
                    <div class="col-span-1 bg-[#FDF2F2] border border-red-100 rounded-2xl p-3 flex flex-col justify-center items-center text-center shadow-sm shadow-rose-500/5">
                        <span class="text-[9px] font-bold text-gray-400 uppercase tracking-wider">Mc Ceklist</span>
                        <span class="text-sm font-black text-red-600 mt-1">8</span>
                    </div>

                    <!-- Row 2 -->
                    <div class="col-span-2 bg-gradient-to-r from-slate-800 to-slate-900 text-white rounded-2xl p-4 shadow-sm flex flex-col justify-center">
                        <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">Date :</span>
                        <span class="text-sm font-extrabold mt-0.5">August - 27 - 2026</span>
                    </div>
                    <div class="col-span-1 bg-[#EBF7EE] border border-green-100 rounded-2xl p-3 flex flex-col justify-center items-center text-center shadow-sm shadow-emerald-500/5">
                        <span class="text-[9px] font-bold text-gray-400 uppercase tracking-wider">Speech</span>
                        <span class="text-sm font-black text-green-700 mt-1">Filled</span>
                    </div>
                    <div class="col-span-1 bg-[#FDF2F2] border border-red-100 rounded-2xl p-3 flex flex-col justify-center items-center text-center shadow-sm shadow-rose-500/5">
                        <span class="text-[9px] font-bold text-gray-400 uppercase tracking-wider">Translate</span>
                        <span class="text-sm font-black text-red-600 mt-1">Empty</span>
                    </div>
                    <div class="col-span-1 bg-[#EBF7EE] border border-green-100 rounded-2xl p-3 flex flex-col justify-center items-center text-center shadow-sm shadow-emerald-500/5">
                        <span class="text-[9px] font-bold text-gray-400 uppercase tracking-wider">Prayers</span>
                        <span class="text-sm font-black text-green-700 mt-1">Filled</span>
                    </div>
                </div>

                <!-- Assigned Roles Section -->
                <div>
                    <h4 class="text-sm font-bold text-gray-800 mb-3 flex items-center gap-2">
                        <i class="bi bi-person text-gray-650"></i> Assigned Roles
                    </h4>
                    <div class="overflow-hidden border border-slate-100 rounded-2xl">
                        <table class="w-full text-left text-xs text-gray-500">
                            <thead class="text-[10px] text-gray-400 uppercase bg-slate-50/60 border-b border-slate-100">
                                <tr>
                                    <th scope="col" class="px-5 py-3 font-bold tracking-wider">Role</th>
                                    <th scope="col" class="px-5 py-3 font-bold tracking-wider text-center">Name</th>
                                    <th scope="col" class="px-5 py-3 font-bold tracking-wider text-right">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <tr class="hover:bg-slate-50/50 transition duration-150">
                                    <td class="px-5 py-3.5 font-bold text-gray-700">Prayers Reader</td>
                                    <td class="px-5 py-3.5 text-center font-bold text-gray-850">Nira</td>
                                    <td class="px-5 py-3.5 text-right">
                                        <span class="inline-flex items-center gap-1 text-emerald-600 font-bold bg-emerald-50 px-2.5 py-0.5 rounded-full text-[10px]">
                                            <i class="bi bi-check-circle"></i> Ready
                                        </span>
                                    </td>
                                </tr>
                                <tr class="hover:bg-slate-50/50 transition duration-150">
                                    <td class="px-5 py-3.5 font-bold text-gray-700">Ceremony MC</td>
                                    <td class="px-5 py-3.5 text-center font-medium text-gray-400">-</td>
                                    <td class="px-5 py-3.5 text-right">
                                        <span class="inline-flex items-center gap-1 text-rose-600 font-bold bg-rose-50 px-2.5 py-0.5 rounded-full text-[10px]">
                                            <i class="bi bi-x-circle"></i> Empty
                                        </span>
                                    </td>
                                </tr>
                                <tr class="hover:bg-slate-50/50 transition duration-150">
                                    <td class="px-5 py-3.5 font-bold text-gray-700">Translator</td>
                                    <td class="px-5 py-3.5 text-center font-bold text-gray-850">Nira</td>
                                    <td class="px-5 py-3.5 text-right">
                                        <span class="inline-flex items-center gap-1 text-emerald-600 font-bold bg-emerald-50 px-2.5 py-0.5 rounded-full text-[10px]">
                                            <i class="bi bi-check-circle"></i> Ready
                                        </span>
                                    </td>
                                </tr>
                                <tr class="hover:bg-slate-50/50 transition duration-150">
                                    <td class="px-5 py-3.5 font-bold text-gray-700">Speech Reader</td>
                                    <td class="px-5 py-3.5 text-center font-medium text-gray-400">-</td>
                                    <td class="px-5 py-3.5 text-right">
                                        <span class="inline-flex items-center gap-1 text-rose-600 font-bold bg-rose-50 px-2.5 py-0.5 rounded-full text-[10px]">
                                            <i class="bi bi-x-circle"></i> Empty
                                        </span>
                                    </td>
                                </tr>
                                <tr class="hover:bg-slate-50/50 transition duration-150">
                                    <td class="px-5 py-3.5 font-bold text-gray-700">Dirigent</td>
                                    <td class="px-5 py-3.5 text-center font-bold text-gray-850">Nira</td>
                                    <td class="px-5 py-3.5 text-right">
                                        <span class="inline-flex items-center gap-1 text-emerald-600 font-bold bg-emerald-50 px-2.5 py-0.5 rounded-full text-[10px]">
                                            <i class="bi bi-check-circle"></i> Ready
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- KOLOM KANAN (Spans 2 cols): UP COMING SCHEDULE & PRACTICE -->
        <div class="lg:col-span-2 space-y-6">
            
            <!-- Up Coming Schedule Card -->
            <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
