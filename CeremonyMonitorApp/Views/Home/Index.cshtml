                        </div>
                    </div>

                    <!-- Card 4 -->
                    <div class="bg-gradient-to-br from-green-50/70 to-green-100/20 border border-green-100/70 rounded-2xl p-4 space-y-2.5 hover:shadow-md hover:scale-[1.02] transition-all duration-300">
                        <div class="flex items-center gap-2 text-[10px] font-extrabold text-gray-700 uppercase tracking-wide">
                            <i class="bi bi-calendar3 text-[#107C41]"></i> 27 - September - 2026
                        </div>
