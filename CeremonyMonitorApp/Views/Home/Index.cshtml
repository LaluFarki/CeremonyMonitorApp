@{
    ViewData["Title"] = "Ceremony Dashboard";
}

<!-- Header Halaman -->
<div class="mb-6">
    <h1 class="text-3xl font-bold text-[#17233F] tracking-tight">Ceremony Dashboard</h1>
    <p class="text-sm text-gray-500 mt-1">Manage the monthly ceremony schedule and assignment status.</p>
</div>

<!-- Quick Stats Section -->
<div class="mb-8">
    <h2 class="text-lg font-bold text-gray-800 mb-3">Quick Stats</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Stat 1: Scheduled -->
     <!-- Stat 1: Scheduled -->
    <div class="bg-[#EBF3FF] border border-blue-100 rounded-2xl px-5 pt-2 pb-5 shadow-sm flex flex-col justify-between h-32 hover:shadow-md transition duration-200">
        <div class="flex items-center gap-2 text-sm font-bold text-[#0050A0] ">
            <i class="text-2xl bi bi-calendar3 "></i> SCHEDULED
        </div>
        <div class="text-4xl font-black text-gray-800">11 CEREMONY</div>
    </div>


        <!-- Stat 2: On Progress -->
        <div class="bg-[#EBF7EE] border border-green-100 rounded-2xl px-5 pt-2 pb-5  shadow-sm flex flex-col justify-between h-32 hover:shadow-md transition duration-200 relative">
            <div class="flex items-center gap-2 text-sm font-bold text-[#107C41]">
                <i class="text-2xl bi bi-arrow-repeat"></i> ON PROGRESS
            </div>
            <div class="text-4xl font-black text-gray-800">1 SCHEDULE</div>
            <div class="absolute bottom-5 right-5 text-xs font-semibold text-[#107C41]">Agustus 2026</div>
        </div>

        <!-- Stat 3: History -->
        <div class="bg-[#FDF2F2] border border-red-100 rounded-2xl px-5 pt-2 pb-5  shadow-sm flex flex-col justify-between h-32 hover:shadow-md transition duration-200">
            <div class="flex items-center gap-2 text-sm font-bold text-[#C53030]">
                <i class="text-2xl bi bi-clock-history"></i> HISTORY
            </div>
            <div class="text-4xl font-black text-gray-600">18 CEREMONY</div>
        </div>
    </div>
</div>
