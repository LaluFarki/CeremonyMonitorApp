                        <div class="flex items-center gap-2 text-[10px] font-extrabold text-gray-700 uppercase tracking-wide">
                            <i class="bi bi-building text-[#107C41]"></i> Audio
                        </div>
                        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[9px] font-bold bg-yellow-100 text-yellow-800">
